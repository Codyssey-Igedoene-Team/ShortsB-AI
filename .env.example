# 임베딩 모델 ID (기본값: nlpai-lab/KURE-v1)
EMBEDDING_MODEL_ID=

# 고정 모델 revision (Hugging Face commit SHA 40자리)
EMBEDDING_MODEL_REVISION=

# 실행 장치 (기본값: cuda, 로컬 CPU 확인 시 cpu)
EMBEDDING_DEVICE=

# 다운로드한 모델의 캐시 경로 (미지정 시 라이브러리 기본 경로)
MODEL_CACHE_DIR=

# 내부 API 인증키 (설정하면 X-API-Key 헤더 필요)
EMBEDDING_API_KEY=
